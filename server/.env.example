# Server Environment Configuration
NODE_ENV=development
PORT=3001

# Allowed Frontend Origins (comma-separated, no trailing slashes)
# In production: https://proviprints.pages.dev,https://provi-admin.pages.dev
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Cookie Configuration
# Use 'strict' locally or when client/admin/api share the same root custom domain.
# Leave unset or set to 'none' in production when using separate .pages.dev and .run.app domains.
COOKIE_SAMESITE=strict
# Optional: .proviprints.com (only when using a custom domain across subdomains)
COOKIE_DOMAIN=

# JWT Secret (Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_64_byte_random_hex_secret

# MySQL / TiDB Cloud Serverless Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_db_password
DB_DATABASE=provi_prints
# Set to 'true' for TiDB Cloud Serverless / Aiven MySQL, or 'false' for local unencrypted MySQL
DB_SSL=false
DB_POOL_MAX=5

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PRIVATE_BUCKET_NAME=design-masters-private
R2_PUBLIC_BUCKET_NAME=design-previews-public
R2_PUBLIC_DOMAIN=https://pub-xxxxxxxxxxxx.r2.dev
STORE_NAME=PROVI-PRINTS
