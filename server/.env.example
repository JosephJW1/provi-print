DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_DATABASE=your_database_name
DB_HOST=127.0.0.1

# Auth Variables
JWT_SECRET=your_generated_jwt_secret
NODE_ENV=development

# Admin Credentials
ADMIN_USERNAME=your_admin_username
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_admin_password

# Cloudflare R2 Object Storage (Dual-Bucket Setup)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_BUCKET_NAME=design-previews-public
R2_PRIVATE_BUCKET_NAME=design-masters-private
R2_PUBLIC_DOMAIN=https://pub-xxxxxxxxxxxx.r2.dev
STORE_NAME=PROVI-PRINTS
